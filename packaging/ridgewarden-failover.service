[Unit]
Description=ridgewarden-failover, MeshChat-compatible chat that survives site loss on AREDN meshes
Documentation=https://github.com/Londopy/ridgewarden-failover
After=network-online.target ridgewarden.service
Wants=network-online.target

[Service]
# its own user, in the core's group: it can read the core's local.token, not its station key
User=ridgewarden-failover
Group=ridgewarden-failover
SupplementaryGroups=ridgewarden
ExecStart=/usr/bin/ridgewarden-failover --config /etc/ridgewarden/failover.toml run
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# shared files go in and out through the core's import and export folders
ReadWritePaths=/var/lib/ridgewarden-failover /var/lib/ridgewarden/imports /var/lib/ridgewarden/exports

[Install]
WantedBy=multi-user.target
